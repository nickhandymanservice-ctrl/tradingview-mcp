# Copy this file to ".env" and fill in your values. .env is git-ignored.
# With NO .env at all, the app runs against an offline demo portfolio.

# ---- Broker selection -------------------------------------------------------
# "demo" (default, offline sample data) or "robinhood" (your real account).
RH_ADVISOR_BROKER=demo

# ---- Robinhood credentials (only needed when RH_ADVISOR_BROKER=robinhood) ---
RH_USERNAME=
RH_PASSWORD=
# Optional: base32 TOTP secret so 2FA logins work headlessly. In the Robinhood
# app, enable authenticator-app 2FA and copy the setup key shown.
RH_MFA_SECRET=

# ---- Trading safety ---------------------------------------------------------
# Must be exactly "yes" for ANY real order to be submitted. Anything else keeps
# the app in dry-run mode (it still proposes & confirms, but only simulates).
RH_ADVISOR_ALLOW_LIVE_TRADES=no
# Per-order dollar ceiling. Proposals above this are flagged. Fat-finger guard.
RH_ADVISOR_MAX_ORDER_USD=2000

# ---- Plan defaults ----------------------------------------------------------
RH_ADVISOR_RISK_PROFILE=balanced          # conservative | balanced | aggressive
RH_ADVISOR_MONTHLY_CONTRIBUTION=0
